#set page(paper: "a4", margin: (top: 70.8661pt, right: 70.8661pt, bottom: 70.8661pt, left: 70.8661pt), fill: rgb("#ffffffff"), numbering: "1", number-align: center)
#set text(font: ("Libertinus Serif", "New Computer Modern"), size: 11pt, fill: rgb("#1f2328ff"))
